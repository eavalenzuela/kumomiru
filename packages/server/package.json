{
  "name": "@kumomiru/server",
  "version": "0.0.0",
  "description": "Self-hosted API: turns exports (and later live creds) into a Graph",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --test --import tsx ./test/*.test.ts"
  },
  "dependencies": {
    "@kumomiru/adapters": "workspace:*",
    "@kumomiru/aws": "workspace:*",
    "@kumomiru/db": "workspace:*",
    "@kumomiru/graph": "workspace:*",
    "croner": "^10.0.1",
    "fastify": "^5.12.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
