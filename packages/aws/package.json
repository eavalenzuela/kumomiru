{
  "name": "@kumomiru/aws",
  "version": "0.0.0",
  "description": "AWS SDK boundary for kumomiru: read-only discovery client, assume-role, region enumeration, generated least-privilege policy",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx ./test/*.test.ts",
    "policy:gen": "tsx ./scripts/gen-policy.ts"
  },
  "dependencies": {
    "@aws-sdk/client-accessanalyzer": "^3.1136.0",
    "@aws-sdk/client-api-gateway": "^3.1136.0",
    "@aws-sdk/client-auto-scaling": "^3.1136.0",
    "@aws-sdk/client-cloudfront": "^3.1136.0",
    "@aws-sdk/client-cloudtrail": "^3.1136.0",
    "@aws-sdk/client-config-service": "^3.1136.0",
    "@aws-sdk/client-dynamodb": "^3.1136.0",
    "@aws-sdk/client-ec2": "^3.1136.0",
    "@aws-sdk/client-ecr": "^3.1136.0",
    "@aws-sdk/client-ecs": "^3.1136.0",
    "@aws-sdk/client-efs": "^3.1136.0",
    "@aws-sdk/client-eks": "^3.1136.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1136.0",
    "@aws-sdk/client-guardduty": "^3.1136.0",
    "@aws-sdk/client-iam": "^3.1136.0",
    "@aws-sdk/client-kms": "^3.1136.0",
    "@aws-sdk/client-lambda": "^3.1136.0",
    "@aws-sdk/client-organizations": "^3.1136.0",
    "@aws-sdk/client-rds": "^3.1136.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/client-s3-control": "^3.1136.0",
    "@aws-sdk/client-secrets-manager": "^3.1136.0",
    "@aws-sdk/client-securityhub": "^3.1136.0",
    "@aws-sdk/client-sns": "^3.1136.0",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@aws-sdk/client-ssm": "^3.1136.0",
    "@aws-sdk/client-sts": "^3.1136.0",
    "@kumomiru/adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
