{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KumomiruWorkerCanAssume",
      "Effect": "Allow",
      "Principal": {
        "AWS": "<WORKER_HOST_ROLE_ARN>"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "<EXTERNAL_ID>"
        }
      }
    }
  ]
}
