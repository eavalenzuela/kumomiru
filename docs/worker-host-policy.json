{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KumomiruWorkerAssumeScanRole",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/KumomiruScanRole"
    },
    {
      "Sid": "KumomiruWorkerOrganizationsDiscovery",
      "Effect": "Allow",
      "Action": [
        "organizations:DescribeOrganization",
        "organizations:ListRoots",
        "organizations:ListOrganizationalUnitsForParent",
        "organizations:ListAccountsForParent"
      ],
      "Resource": "*"
    }
  ]
}
